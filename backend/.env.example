# 監聽位址；反向代理與 HTTPS 由部署方自行處理
HOST=0.0.0.0
PORT=5121
# 資料庫與媒體檔目錄
DATA_DIR=./data
# 媒體檔網址的前綴；未設定時依請求的 Host 產生
PUBLIC_BASE_URL=
# 允許的前端來源，逗號分隔；* 表示全部允許
CORS_ORIGIN=*

# 身份名單，逗號分隔的城市通使用者 ID；也可由管理員用 API 指定
ADMIN_TOWNPASS_IDS=
BOT_TOWNPASS_IDS=

# FCM 推播（選填）：Firebase 服務帳戶金鑰，擇一設定；都沒有時不發推播
# 金鑰只能放在後端，不可提交到版控
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
# Android 通知通道，要和城市通 App 一致
FCM_CHANNEL_ID=TownPass android notification id
# 點擊通知後開啟的網址，{question_id} 會被替換；設為空字串時推播不帶 url
PUSH_QUESTION_URL=https://tp2026.ydtw.net/?question={question_id}
